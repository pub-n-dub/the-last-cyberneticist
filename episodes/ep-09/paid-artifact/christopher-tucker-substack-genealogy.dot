  schoote -> crossover_bottom -> crossover_top -> golius -> erpenius -> scaliger -> turnebe -> toussain -> bude -> lascaris -> bessarion -> pletho -> kydones -> kabasilas -> palamas -> metochites -> bryennios;
  bryennios:s -> bryennios_elbow_out -> bryennios_elbow_in -> chioniades:n;
