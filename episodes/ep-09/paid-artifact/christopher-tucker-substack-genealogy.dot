digraph substack_academic_genealogy {
  graph [
    rankdir=TB,
    bgcolor="white",
    margin=0.55,
    pad=0.25,
    nodesep=1.05,
    ranksep=0.30,
    splines=ortho,
    labelloc="t",
    labeljust="c",
    fontname="Liberation Serif",
    fontsize=26,
    fontcolor="#242424",
    label="Christopher Allen Tucker:\nAcademic Genealogy"
  ];

  node [
    shape=plain,
    fontname="Liberation Serif",
    fontsize=15,
    fontcolor="#242424"
  ];

  edge [
    dir=none,
    color="#242424",
    penwidth=1.05
  ];

  tucker [label=<<B>Christopher Allen Tucker</B><BR/><FONT POINT-SIZE="11">University of Reading, Ph.D., 2013</FONT>>];
  warwick [label=<<B>Kevin Warwick</B><BR/><FONT POINT-SIZE="11">Imperial College London, Ph.D., 1982</FONT>>];
  westcott [group="left", label=<<B>John Hugh Westcott</B><BR/><FONT POINT-SIZE="11">University of London, Ph.D., 1951</FONT>>];
  cherry [group="right", label=<<B>Colin Edward Cherry</B><BR/><FONT POINT-SIZE="11">Imperial College London</FONT>>];
  wiener [group="left", label=<<B>Norbert Wiener</B><BR/><FONT POINT-SIZE="11">Harvard University, Ph.D., 1913 · MIT</FONT>>];
  schmidt [group="left", label=<Karl Schmidt<BR/><FONT POINT-SIZE="11">Philipps-Universität Marburg</FONT>>];
  natorp [group="left", label=<<B>Paul Gerhard Natorp</B><BR/><FONT POINT-SIZE="11">University of Marburg</FONT>>];
  laas [group="left", label=<Ernst Laas<BR/><FONT POINT-SIZE="11">University of Strasbourg</FONT>>];
  trendelenburg [group="left", label=<<B>Friedrich Adolf Trendelenburg</B><BR/><FONT POINT-SIZE="11">University of Berlin</FONT>>];
  reinhold [group="right", label=<Karl Leonhard Reinhold<BR/><FONT POINT-SIZE="11">University of Jena</FONT>>];
  kant [group="right", label=<<B>Immanuel Kant</B><BR/><FONT POINT-SIZE="11">University of Königsberg</FONT>>];
  knutzen [group="right", label=<Martin Knutzen<BR/><FONT POINT-SIZE="11">University of Königsberg</FONT>>];
  wolff [group="right", label=<Christian Wolff<BR/><FONT POINT-SIZE="11">University of Halle</FONT>>];
  leibniz [group="right", label=<<B>Gottfried Wilhelm Leibniz</B><BR/><FONT POINT-SIZE="11">University of Altdorf</FONT>>];
  huygens [group="left", label=<<B>Christiaan Huygens</B><BR/><FONT POINT-SIZE="11">Leiden University</FONT>>];
  schoote [group="left", label=<<B>Frans van Schooten</B><BR/><FONT POINT-SIZE="11">Leiden University</FONT>>];
  golius [group="left", label=<<B>Jacobus Golius</B><BR/><FONT POINT-SIZE="11">Leiden University</FONT>>];
  erpenius [group="left", label=<Thomas van Erpe (Erpenius)<BR/><FONT POINT-SIZE="11">Leiden University</FONT>>];
  scaliger [group="left", label=<<B>Joseph Justus Scaliger</B><BR/><FONT POINT-SIZE="11">Leiden University</FONT>>];
  turnebe [group="right", label=<<B>Adrien Turnèbe</B><BR/><FONT POINT-SIZE="11">Collège de France</FONT>>];
  toussain [label="Jacques Toussain"];
  bude [label="Guillaume Budé"];
  lascaris [label="Janus Lascaris"];
  bessarion [group="right", label=<<B>Basilios Bessarion</B>>];
  pletho [group="left", label=<<B>Georgios Plethon Gemistos</B>>];
  kydones [group="left", label="Demetrios Kydones"];
  kabasilas [group="left", label="Neilos Kabasilas"];
  palamas [group="left", label=<<B>Gregory Palamas</B>>];
  metochites [group="left", label="Theodore Metochites"];
  bryennios [group="left", label="Manuel Bryennios"];
  chioniades [group="right", label="Gregory Chioniades"];
